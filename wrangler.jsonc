{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dprgrmmd-site",
  "main": "src/worker-classic.js",
  "compatibility_date": "2026-09-14",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "dprgrmmd.com",
      "custom_domain": true
    }
